# membox-server configuration (ADR-004: env only; this file is a template —
# copy to .env for local development, NEVER commit real credentials).

# "development" or "production"
APP_ENV=development

# Listen address. Development default is 127.0.0.1:8081.
HTTP_ADDR=127.0.0.1:8081

# PostgreSQL DSN (required from milestone M2 onward).
DATABASE_URL=postgres://membox:membox@127.0.0.1:5432/membox?sslmode=disable

# Cloudflare R2 (all-or-nothing). Use a private bucket with credentials
# scoped to that bucket only; never reuse the prod key for dev.
R2_ACCOUNT_ID=
R2_BUCKET=membox-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Outbound mail for OTP login (M3). Mailpit in dev, real SMTP in prod.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=membox@example.com

# HMAC secret for OTP challenge storage (M3). Generate a long random value.
OTP_HMAC_SECRET=

# Externally reachable base URL (behind tunnel / reverse proxy).
PUBLIC_BASE_URL=http://127.0.0.1:8081

# Upload body limit in bytes. Default 200 MiB.
MAX_UPLOAD_BYTES=209715200

# compose-only: PostgreSQL password (referenced by deploy/membox-server/compose.yml)
POSTGRES_PASSWORD=
