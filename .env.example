MEMBOX_DOCS_DIR=/ABS/PATH/TO/YOUR/GOOGLE/DRIVE/DOCS

# Optional: have mmd manage the SSH tunnel to a remote Perkeep server.
# If MM_TUNNEL_HOST is set, mmd will spawn and restart the tunnel automatically.
MM_TUNNEL_HOST=38.207.176.66
MM_TUNNEL_USER=edward
MM_TUNNEL_PORT=43568
MM_TUNNEL_REMOTE_PORT=3179
MM_TUNNEL_LOCAL_PORT=3179
# MM_TUNNEL_KEY=/path/to/private/key
# MM_TUNNEL_EXTRA_ARGS=-o IdentitiesOnly=yes

# Optional: override the Perkeep server prefix used by pk/pk-put.
# MM_PERKEEP_SERVER=http://127.0.0.1:3179

# Optional: how often mmd pushes to Perkeep (default 60s).
# MM_SYNC_INTERVAL=60s
