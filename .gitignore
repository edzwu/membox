# membox local build artifacts
/bin/
/dist/
/mm

# test/coverage output
/coverage.out
/coverage.html

# Local isolated mmd database and runtime files
/tempbox/

# Go workspace files
go.work
go.work.sum

# editor/system files
.DS_Store
.idea/
.vscode/

# membox-server local credentials (ADR-004: never commit real secrets)
.env

# browser extension (WXT)
node_modules/
extensions/*/.output/
extensions/*/.wxt/
extensions/*/dist/

# membox-server home app: generated vite output (built by `make remote-web`)
internal/interfaces/httpserver/static/*
!internal/interfaces/httpserver/static/.gitkeep
